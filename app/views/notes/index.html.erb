<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <header class="bg-white shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
      <h1 class="text-2xl font-bold text-gray-900"><%= t("notes.my_notes") %></h1>
      <div class="flex items-center space-x-4">
        <span class="text-sm text-gray-600"><%= current_user.display_name %></span>
        <%= button_to t("sessions.sign_out"), sign_out_path, method: :delete, class: "text-sm text-red-600 hover:text-red-800" %>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- New Note Button -->
    <div class="mb-8">
      <%= link_to t("notes.new_note"), new_note_path, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500", data: { turbo_frame: "new_note_modal" } %>
    </div>

    <% if @notes.empty? %>
      <div class="text-center py-12">
        <p class="text-gray-500 text-lg"><%= t("notes.no_notes") %></p>
      </div>
    <% else %>
      <!-- Pinned Notes -->
      <% pinned_notes = @notes.select(&:pinned) %>
      <% if pinned_notes.any? %>
        <div class="mb-8">
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4"><%= t("notes.pinned_notes") %></h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
            <%= render partial: "note_card", collection: pinned_notes, as: :note %>
          </div>
        </div>
      <% end %>

      <!-- Other Notes -->
      <% unpinned_notes = @notes.reject(&:pinned) %>
      <% if unpinned_notes.any? %>
        <div>
          <% if pinned_notes.any? %>
            <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4"><%= t("notes.other_notes") %></h2>
          <% end %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
            <%= render partial: "note_card", collection: unpinned_notes, as: :note %>
          </div>
        </div>
      <% end %>
    <% end %>
  </main>
</div>
