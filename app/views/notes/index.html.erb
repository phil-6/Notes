<div class="min-h-screen bg-gray-50 dark:bg-gray-900">
  <!-- Header -->
  <header class="bg-white dark:bg-gray-800 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t("notes.my_notes") %></h1>
      <div class="flex items-center space-x-4" data-controller="theme">
        <%= form_with model: current_user, url: preferences_path, method: :patch do |form| %>
          <%= form.check_box :dark_mode, data: { action: "change->theme#toggle" }, class: "sr-only peer" %>
          <label for="user_dark_mode" class="cursor-pointer inline-flex items-center text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">
            <svg class="w-5 h-5 hidden dark:block" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
            <svg class="w-5 h-5 block dark:hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
          </label>
        <% end %>
        <span class="text-sm text-gray-600 dark:text-gray-300"><%= current_user.display_name %></span>
        <%= button_to t("sessions.sign_out"), sign_out_path, method: :delete, class: "text-sm text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300" %>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Flash Messages -->
    <div id="flash_messages"></div>

    <!-- Navigation & Actions -->
    <div class="mb-8 flex flex-wrap gap-3">
      <%= link_to t("notes.new_note"), new_note_path, data: { turbo_frame: "note_modal_frame", action: "click->modal#open" }, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      <%= link_to t("shared_notes.title"), shared_notes_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      <%= link_to t("connections.title"), connections_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    </div>

    <% if @notes.empty? %>
      <div id="notes_list" class="text-center py-12">
        <p class="text-gray-500 dark:text-gray-400 text-lg"><%= t("notes.no_notes") %></p>
      </div>
    <% else %>
      <div id="notes_list">
        <!-- Pinned Notes -->
        <% pinned_notes = @notes.select(&:pinned) %>
        <% if pinned_notes.any? %>
          <div class="mb-8" id="pinned_section">
            <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-4"><%= t("notes.pinned_notes") %></h2>
            <div id="pinned_notes_grid"
                 class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"
                 data-controller="sortable"
                 data-sortable-url-value="<%= reorder_note_path(':id') %>">
              <%= render partial: "note_card", collection: pinned_notes, as: :note %>
            </div>
          </div>
        <% end %>

        <!-- Other Notes -->
        <% unpinned_notes = @notes.reject(&:pinned) %>
        <div id="unpinned_section">
          <% if pinned_notes.any? && unpinned_notes.any? %>
            <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-4"><%= t("notes.other_notes") %></h2>
          <% end %>
          <div id="unpinned_notes_grid"
               class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"
               data-controller="sortable"
               data-sortable-url-value="<%= reorder_note_path(':id') %>">
            <% if unpinned_notes.any? %>
              <%= render partial: "note_card", collection: unpinned_notes, as: :note %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </main>

  <!-- Note Modal -->
  <div data-controller="modal" id="note_modal">
    <dialog data-modal-target="dialog"
            class="rounded-lg shadow-xl backdrop:bg-gray-900 backdrop:bg-opacity-50 p-0 max-w-4xl w-full max-h-[90vh] overflow-hidden">
      <div class="bg-white dark:bg-gray-800 rounded-lg max-h-[90vh] flex flex-col">
        <div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700 flex-shrink-0">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white" id="modal_title"></h2>
          <button type="button"
                  data-action="modal#close"
                  class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors"
                  aria-label="Close">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="p-6 overflow-y-auto flex-grow">
          <%= turbo_frame_tag "note_modal_frame" do %>
          <% end %>
        </div>
      </div>
    </dialog>
  </div>
</div>
