<%= form_with model: note, class: "space-y-6" do |form| %>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
      <%= t("activerecord.attributes.note.title") %>
    </label>
    <%= form.text_field :title,
        placeholder: t("activerecord.attributes.note.title"),
        class: "w-full text-lg font-medium border border-gray-300 dark:border-gray-600 rounded-lg px-4 py-3 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors" %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
      <%= t("activerecord.attributes.note.content") %>
    </label>
    <%= form.rich_text_area :content,
        placeholder: t("activerecord.attributes.note.content"),
        class: "w-full min-h-[300px]" %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">
      <%= t("activerecord.attributes.note.color") %>
    </label>
    <div class="flex flex-wrap gap-2">
      <% Note::COLORS.each do |color| %>
        <label class="cursor-pointer group" title="<%= color.capitalize %>">
          <%= form.radio_button :color, color, class: "sr-only peer" %>
          <div class="w-10 h-10 rounded-lg border-2 border-gray-300 dark:border-gray-600 peer-checked:ring-2 peer-checked:ring-blue-500 peer-checked:ring-offset-2 peer-checked:scale-110 hover:scale-110 transition-all <%= color_preview_class(color) %>"></div>
        </label>
      <% end %>
    </div>
  </div>

  <div class="flex items-center justify-between pt-4 border-t border-gray-200 dark:border-gray-700">
    <%= form.label :pinned, class: "inline-flex items-center cursor-pointer" do %>
      <%= form.check_box :pinned, class: "rounded border-gray-300 dark:border-gray-600 text-blue-600 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50 mr-2" %>
      <span class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= t("activerecord.attributes.note.pinned") %></span>
    <% end %>

    <div class="flex items-center gap-3">
      <%= link_to "Cancel", notes_path, class: "px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
      <%= form.submit note.persisted? ? t("common.save") : t("notes.create"), class: "px-6 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors shadow-sm" %>
    </div>
  </div>
<% end %>
