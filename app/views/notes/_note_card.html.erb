<%
  note_color = note_card_color_class(note.color)
  is_shared = note.user_id != current_user.id
  can_edit = note.user_id == current_user.id || note.can_be_edited_by?(current_user)
  is_locked_by_other = note.locked? && !note.locked_by?(current_user)
%>

<%= turbo_frame_tag dom_id(note) do %>
  <div class="<%= note_color %> border border-gray-200 dark:border-gray-700 rounded-lg p-4 hover:shadow-md transition-shadow duration-200 group relative">
    <%# Lock indicator %>
    <% if is_locked_by_other %>
      <div class="absolute top-2 right-2 flex items-center gap-1 text-xs text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-900/20 px-2 py-1 rounded-full">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
        <span><%= t("notes.locked_by", user: note.locked_by.display_name) %></span>
      </div>
    <% elsif is_shared %>
      <div class="absolute top-2 right-2 flex items-center gap-1 text-xs text-gray-500 dark:text-gray-400 bg-white/80 dark:bg-gray-800/80 px-2 py-1 rounded-full">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"/></svg>
        <span><%= note.user.display_name %></span>
        <% if can_edit %>
          <svg class="w-3 h-3 text-green-600 dark:text-green-400" fill="currentColor" viewBox="0 0 20 20"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg>
        <% end %>
      </div>
    <% end %>

    <%# Card content - clickable to edit if permitted %>
    <% if can_edit && !is_locked_by_other %>
      <%= link_to edit_note_path(note), data: { turbo_frame: dom_id(note, :edit) }, class: "block" do %>
        <% if note.title.present? %>
          <h3 class="font-medium text-gray-900 dark:text-gray-100 mb-2 <%= 'pr-20' if is_shared || is_locked_by_other %>"><%= note.title %></h3>
        <% end %>

        <% if note.content.present? %>
          <div class="text-sm text-gray-700 dark:text-gray-300 line-clamp-6 prose prose-sm max-w-none">
            <%= note.content.to_plain_text.truncate(200) %>
          </div>
        <% end %>

        <% if note.tags.any? %>
          <div class="mt-3 flex flex-wrap gap-1">
            <% note.tags.each do |tag| %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200">
                <%= tag.name %>
              </span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <%# Read-only view %>
      <div class="block">
        <% if note.title.present? %>
          <h3 class="font-medium text-gray-900 dark:text-gray-100 mb-2 pr-20"><%= note.title %></h3>
        <% end %>

        <% if note.content.present? %>
          <div class="text-sm text-gray-700 dark:text-gray-300 line-clamp-6 prose prose-sm max-w-none">
            <%= note.content.to_plain_text.truncate(200) %>
          </div>
        <% end %>

        <% if note.tags.any? %>
          <div class="mt-3 flex flex-wrap gap-1">
            <% note.tags.each do |tag| %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200">
                <%= tag.name %>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Actions (only for owned notes) %>
    <% if note.user_id == current_user.id %>
      <div class="mt-3 pt-2 border-t border-gray-200 dark:border-gray-700 flex justify-between items-center opacity-0 group-hover:opacity-100 transition-opacity duration-200">
        <div class="flex space-x-2">
          <% if note.pinned? %>
            <%= button_to unpin_note_path(note), method: :patch, class: "text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300", title: t("notes.unpin"), "aria-label": t("notes.unpin") do %>
              <svg class="w-5 h-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><title><%= t("notes.unpin") %></title><path d="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z"/></svg>
            <% end %>
          <% else %>
            <%= button_to pin_note_path(note), method: :patch, class: "text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300", title: t("notes.pin"), "aria-label": t("notes.pin") do %>
              <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><title><%= t("notes.pin") %></title><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
            <% end %>
          <% end %>
        </div>

        <%= button_to note_path(note), method: :delete, data: { turbo_confirm: t("notes.delete_confirm") }, class: "text-gray-500 dark:text-gray-400 hover:text-red-600 dark:hover:text-red-400", title: t("notes.delete"), "aria-label": t("notes.delete") do %>
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><title><%= t("notes.delete") %></title><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Inline edit frame %>
  <%= turbo_frame_tag dom_id(note, :edit) %>
<% end %>
