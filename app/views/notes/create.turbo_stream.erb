<% if @note.pinned %>
  <%= turbo_stream.prepend "pinned_notes_grid" do %>
    <%= render partial: "note_card", locals: { note: @note } %>
  <% end %>
<% else %>
  <%= turbo_stream.prepend "unpinned_notes_grid" do %>
    <%= render partial: "note_card", locals: { note: @note } %>
  <% end %>
<% end %>

<%# Close the modal %>
<%= turbo_stream.update "note_modal_frame" do %>
<% end %>

<%# Flash message %>
<%= turbo_stream.update "flash_messages" do %>
  <div class="bg-green-100 dark:bg-green-900/20 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-400 px-4 py-3 rounded relative mb-4" role="alert">
    <span class="block sm:inline"><%= t("notes.created") %></span>
  </div>
<% end %>

<script>
  // Close modal after successful creation
  const modal = document.querySelector('#note_modal [data-modal-target="dialog"]')
  if (modal && modal.open) {
    modal.close()
    document.body.classList.remove('overflow-hidden')
  }
</script>
