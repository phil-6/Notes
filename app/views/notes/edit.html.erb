<%= turbo_frame_tag "note_modal_frame", data: { modal_title: t("notes.editing") } do %>
  <div class="flex items-center justify-between mb-4">
    <%= link_to t("versions.view_history"),
        note_versions_path(@note),
        target: "_top",
        class: "text-sm text-blue-600 dark:text-blue-400 hover:underline" %>
  </div>

  <%= render "form", note: @note %>
<% end %>
