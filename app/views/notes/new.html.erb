<%= turbo_frame_tag "note_modal_frame" do %>
  <%= render "form", note: @note %>
<% end %>

<script>
  document.addEventListener('turbo:frame-load', (event) => {
    if (event.target.id === 'note_modal_frame') {
      document.getElementById('modal_title').textContent = '<%= j t("notes.new_note") %>'
      const modal = document.querySelector('#note_modal [data-modal-target="dialog"]')
      if (modal && !modal.open) {
        modal.showModal()
        document.body.classList.add('overflow-hidden')
      }
    }
  })
</script>
