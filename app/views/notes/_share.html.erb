<div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4"><%= t("notes.share") %></h3>

  <% if current_user.connected_users.any? %>
    <!-- Share Form -->
    <%= form_with url: note_shared_notes_path(note), method: :post, class: "mb-4" do |form| %>
      <div class="space-y-2">
        <div class="flex gap-2">
          <%= select_tag :user_id, options_from_collection_for_select(current_user.connected_users, :id, :display_name), { prompt: t("shared_notes.select_connection") }, class: "flex-1 rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
          <%= submit_tag t("shared_notes.share_note"), class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 text-sm" %>
        </div>
        <label class="flex items-center text-sm text-gray-700 dark:text-gray-300">
          <%= check_box_tag :can_edit, "1", false, class: "rounded border-gray-300 dark:border-gray-600 text-blue-600 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50" %>
          <span class="ml-2"><%= t("shared_notes.allow_editing") %></span>
        </label>
      </div>
    <% end %>

    <!-- Already Shared With -->
    <% if note.shared_with_users.any? %>
      <div class="mt-4">
        <p class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"><%= t("notes.shared_with") %>:</p>
        <div class="space-y-2">
          <% note.shared_withs.includes(:user).each do |shared_with| %>
            <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
              <div class="flex items-center gap-2">
                <span class="text-sm text-gray-900 dark:text-white"><%= shared_with.user.display_name %></span>
                <% if shared_with.can_edit? %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/20 dark:text-green-400">
                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg>
                    <%= t("shared_notes.can_edit") %>
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-900/20 dark:text-gray-400">
                    <%= t("shared_notes.read_only") %>
                  </span>
                <% end %>
              </div>
              <%= button_to t("shared_notes.unshare"), note_shared_note_path(note, shared_with), method: :delete, data: { turbo_confirm: t("shared_notes.unshare_confirm") }, class: "text-sm text-red-600 dark:text-red-400 hover:text-red-800" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="text-sm text-gray-600 dark:text-gray-400">
      <%= t("connections.no_connections") %>. <%= link_to t("connections.add_connection"), connections_path, class: "text-blue-600 dark:text-blue-400 hover:underline" %>
    </p>
  <% end %>
</div>
