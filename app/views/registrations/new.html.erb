<div class="min-h-screen flex items-center justify-center bg-gray-50">
  <div class="max-w-md w-full space-y-8 p-8 bg-white rounded-lg shadow">
    <div>
      <h2 class="text-center text-3xl font-bold text-gray-900">
        <%= t("registrations.sign_up") %>
      </h2>
    </div>

    <%= form_with model: @user, url: sign_up_path, class: "mt-8 space-y-6" do |form| %>
      <div class="space-y-4">
        <div>
          <%= form.label :email, t("activerecord.attributes.user.email"), class: "block text-sm font-medium text-gray-700" %>
          <%= form.email_field :email, required: true, autofocus: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
          <% if @user.errors[:email].any? %>
            <p class="mt-1 text-sm text-red-600"><%= @user.errors[:email].first %></p>
          <% end %>
        </div>

        <div>
          <%= form.label :display_name, t("activerecord.attributes.user.display_name"), class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :display_name, required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
          <% if @user.errors[:display_name].any? %>
            <p class="mt-1 text-sm text-red-600"><%= @user.errors[:display_name].first %></p>
          <% end %>
        </div>

        <div>
          <%= form.label :password, t("activerecord.attributes.user.password"), class: "block text-sm font-medium text-gray-700" %>
          <%= form.password_field :password, required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
          <% if @user.errors[:password].any? %>
            <p class="mt-1 text-sm text-red-600"><%= @user.errors[:password].first %></p>
          <% end %>
        </div>

        <div>
          <%= form.label :password_confirmation, t("activerecord.attributes.user.password_confirmation"), class: "block text-sm font-medium text-gray-700" %>
          <%= form.password_field :password_confirmation, required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>
      </div>

      <div>
        <%= form.submit t("registrations.create_account"), class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      </div>
    <% end %>

    <div class="text-center">
      <p class="text-sm text-gray-600">
        <%= t("registrations.have_account") %>
        <%= link_to t("registrations.sign_in"), sign_in_path, class: "font-medium text-blue-600 hover:text-blue-500" %>
      </p>
    </div>
  </div>
</div>
