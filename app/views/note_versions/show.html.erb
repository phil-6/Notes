<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
          <%= t("versions.version_number", number: @version.version_number) %>
        </h2>
        <%= link_to t("common.back"), note_versions_path(@note), class: "text-blue-600 dark:text-blue-400 hover:underline" %>
      </div>

      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            <%= t("versions.change_type") %>
          </label>
          <span class="inline-flex items-center px-3 py-1 rounded text-sm font-medium
            <%= case @version.change_type
                when 'created' then 'bg-green-100 text-green-800 dark:bg-green-900/20 dark:text-green-400'
                when 'updated' then 'bg-blue-100 text-blue-800 dark:bg-blue-900/20 dark:text-blue-400'
                when 'restored' then 'bg-purple-100 text-purple-800 dark:bg-purple-900/20 dark:text-purple-400'
                when 'shared' then 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/20 dark:text-yellow-400'
                when 'unshared' then 'bg-gray-100 text-gray-800 dark:bg-gray-900/20 dark:text-gray-400'
                end %>">
            <%= t("versions.change_types.#{@version.change_type}") %>
          </span>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            <%= t("versions.title") %>
          </label>
          <p class="text-gray-900 dark:text-white"><%= @version.title %></p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            <%= t("versions.color") %>
          </label>
          <p class="text-gray-900 dark:text-white"><%= @version.color %></p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            <%= t("versions.content") %>
          </label>
          <div class="prose dark:prose-invert max-w-none p-4 bg-gray-50 dark:bg-gray-900 rounded border border-gray-200 dark:border-gray-700">
            <%= simple_format(@version.content) %>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            <%= t("versions.metadata") %>
          </label>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            <%= t("versions.created_by", name: @version.created_by_name, time: time_ago_in_words(@version.created_at)) %>
          </p>
        </div>

        <div class="pt-4">
          <%= button_to t("versions.restore"),
              restore_note_version_path(@note, @version),
              method: :post,
              class: "px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors",
              data: { turbo_confirm: t("versions.restore_confirm") } %>
        </div>
      </div>
    </div>
  </div>
</div>
