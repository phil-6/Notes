<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t("versions.history") %></h2>
        <%= link_to t("common.back"), notes_path, class: "text-blue-600 dark:text-blue-400 hover:underline" %>
      </div>

      <div class="mb-4 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg border border-blue-200 dark:border-blue-800">
        <h3 class="font-semibold text-gray-900 dark:text-white mb-2"><%= t("versions.current_version") %></h3>
        <p class="text-sm text-gray-600 dark:text-gray-400"><%= t("versions.title") %>: <span class="font-medium"><%= @note.title %></span></p>
        <p class="text-sm text-gray-600 dark:text-gray-400"><%= t("versions.color") %>: <span class="font-medium"><%= @note.color %></span></p>
      </div>

      <div class="space-y-4">
        <% @versions.each do |version| %>
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4 hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium
                    <%= case version.change_type
                        when 'created' then 'bg-green-100 text-green-800 dark:bg-green-900/20 dark:text-green-400'
                        when 'updated' then 'bg-blue-100 text-blue-800 dark:bg-blue-900/20 dark:text-blue-400'
                        when 'restored' then 'bg-purple-100 text-purple-800 dark:bg-purple-900/20 dark:text-purple-400'
                        when 'shared' then 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/20 dark:text-yellow-400'
                        when 'unshared' then 'bg-gray-100 text-gray-800 dark:bg-gray-900/20 dark:text-gray-400'
                        end %>">
                    <%= t("versions.change_types.#{version.change_type}") %>
                  </span>
                  <span class="text-sm font-semibold text-gray-900 dark:text-white">
                    <%= t("versions.version_number", number: version.version_number) %>
                  </span>
                </div>

                <p class="text-sm text-gray-600 dark:text-gray-400 mb-1">
                  <strong><%= t("versions.title") %>:</strong> <%= version.title %>
                </p>

                <p class="text-sm text-gray-600 dark:text-gray-400 mb-1">
                  <strong><%= t("versions.color") %>:</strong> <%= version.color %>
                </p>

                <% if version.content.present? %>
                  <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">
                    <strong><%= t("versions.content") %>:</strong>
                    <%= truncate(version.content, length: 100) %>
                  </p>
                <% end %>

                <p class="text-xs text-gray-500 dark:text-gray-500">
                  <%= t("versions.created_by", name: version.created_by_name, time: time_ago_in_words(version.created_at)) %>
                </p>
              </div>

              <div class="ml-4">
                <%= button_to t("versions.restore"),
                    restore_note_version_path(@note, version),
                    method: :post,
                    class: "px-3 py-1 bg-blue-600 text-white text-sm rounded hover:bg-blue-700 transition-colors",
                    data: { turbo_confirm: t("versions.restore_confirm") } %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if @versions.empty? %>
        <div class="text-center py-8 text-gray-500 dark:text-gray-400">
          <%= t("versions.no_versions") %>
        </div>
      <% end %>
    </div>
  </div>
</div>
